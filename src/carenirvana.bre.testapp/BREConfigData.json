      "rules": [
        {
          "ruleid": "1",
          "rulename": "OutpatientTransportationAutoApprove",
          "batchrule": "false",
          "errormessage": "Outpatient Transportation auto-approval failed.",
          "enabled": true,
          "expressions": [
            {
              "expression": "authtype == \"Outpatient - Transportation\"",
              "logiccondition": "AND"
            },
            {
              "expression": "authstatus == \"Approved\"",
              "logiccondition": "AND"
            },
            {
              "expression": "proccode IN (\"A0130\", \"A0100\", \"T2005\", \"A0425\", \"S0209\", \"S0215\", \"T2049\")",
              "logiccondition": ""
            }
          ],
          "successevent": "Generate Draft Service Authorization Letter and update Decision Status=Approved, Decision Status Code = met medical necessity, Requested units = approved units",
          "ruleparams": [
            {
              "paramname": "authtype",
              "fieldname": "Authorization Type",
              "type": "string"
            },
            {
              "paramname": "authstatus",
              "fieldname": "Auth Status",
              "type": "string"
            },
            {
              "paramname": "proccode",
              "fieldname": "Procedure Code",
              "type": "string"
            }
          ]
        }
      ]
    }
